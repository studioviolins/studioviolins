# Contact form ("Ask Nick a question") — copy to .env.local for local use, or set these on the host.
# Without the host, username and password the form shows a "couldn't be sent" message and offers WhatsApp/email
# instead; it never reports success unless the email was accepted for delivery.

# SMTP account used to send the message: the violins@studioviolins.co.uk mailbox's own outgoing (SMTP) server,
# from its email provider. Put the password in the host's settings only, never in the code.
CONTACT_SMTP_HOST=
# 465 (implicit TLS, the default) or 587 (STARTTLS).
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# Optional. Where messages are delivered; blank means violins@studioviolins.co.uk (confirmed 22 Nov 2026).
# The visitor's address is set as Reply-To.
CONTACT_TO=
# Optional. The sender address on each message; blank means violins@studioviolins.co.uk. It must be one the
# SMTP account is allowed to send from.
CONTACT_FROM=

# Development only (ignored in production): 1 = write messages to output/dev-outbox/*.eml instead of sending.
# CONTACT_DEV_OUTBOX=1
